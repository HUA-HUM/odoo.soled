<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Accion cliente: los numeros se leen de las APIs al entrar, en vez de
         salir de las tablas locales que solo se llenan al sincronizar a mano.
         Lleva un id nuevo porque Odoo no deja reusar un external id entre
         modelos distintos (antes era ir.actions.act_window). -->
    <record id="action_publisher_dashboard_panel" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">sku_publisher_panel.dashboard_action</field>
    </record>
</odoo>
