<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_publisher_sku_search_wizard_form" model="ir.ui.view">
        <field name="name">publisher.sku.search.wizard.form</field>
        <field name="model">publisher.sku.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Buscar SKU">
                <sheet>
                    <group>
                        <field name="sku" placeholder="Ej: RMS-2M-NEG"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_search_sku" string="Buscar en API" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_publisher_sku_search_wizard" model="ir.actions.act_window">
        <field name="name">Buscar SKU</field>
        <field name="res_model">publisher.sku.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_publisher_sku_search_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
