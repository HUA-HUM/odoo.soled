<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_publisher_job_tree" model="ir.ui.view">
        <field name="name">publisher.job.tree</field>
        <field name="model">publisher.job</field>
        <field name="arch" type="xml">
            <list string="Procesos de publicacion" create="false" decoration-success="status == 'completed'" decoration-danger="status in ('failed', 'completed_with_errors')" decoration-info="status == 'processing'">
                <header>
                    <button name="action_sync_recent_jobs" string="Sincronizar procesos" type="object" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="retailer_targets"/>
                <field name="progress" widget="progressbar"/>
                <field name="total_items"/>
                <field name="done_items"/>
                <field name="error_items"/>
                <field name="backend_job_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_publisher_job_form" model="ir.ui.view">
        <field name="name">publisher.job.form</field>
        <field name="model">publisher.job</field>
        <field name="arch" type="xml">
            <form string="Proceso de publicacion" create="false">
                <header>
                    <button name="action_refresh_progress" string="Actualizar progreso" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="retailer_targets" readonly="1"/>
                            <field name="progress" readonly="1" widget="progressbar"/>
                            <field name="backend_job_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_items" readonly="1"/>
                            <field name="done_items" readonly="1"/>
                            <field name="error_items" readonly="1"/>
                            <field name="message" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lineas">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="status == 'completed'" decoration-danger="status == 'failed'" decoration-warning="status == 'retrying'" decoration-muted="status in ('skipped', 'cancelled')" decoration-info="status == 'processing'">
                                    <button name="action_retry_run" string="Reintentar" type="object" icon="fa-repeat" invisible="status not in ['failed', 'skipped']"/>
                                    <field name="sku"/>
                                    <field name="retailer"/>
                                    <field name="status" widget="badge"/>
                                    <field name="run_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload API">
                            <field name="raw_payload_json" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_publisher_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">publisher.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_publisher_run_tree" model="ir.ui.view">
        <field name="name">publisher.job.line.tree</field>
        <field name="model">publisher.job.line</field>
        <field name="arch" type="xml">
            <list string="Runs de publicacion" create="false" decoration-success="status == 'completed'" decoration-danger="status == 'failed'" decoration-warning="status == 'retrying'" decoration-muted="status in ('skipped', 'cancelled')" decoration-info="status == 'processing'">
                <header>
                    <button name="action_sync_runs" string="Sincronizar runs" type="object" class="btn-primary"/>
                </header>
                <button name="action_retry_run" string="Reintentar" type="object" icon="fa-repeat" invisible="status not in ['failed', 'skipped']"/>
                <field name="sku"/>
                <field name="retailer"/>
                <field name="status" widget="badge"/>
                <field name="attempts"/>
                <field name="max_attempts"/>
                <field name="run_id"/>
                <field name="job_id"/>
                <field name="message"/>
                <field name="error_message"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_publisher_run_form" model="ir.ui.view">
        <field name="name">publisher.job.line.form</field>
        <field name="model">publisher.job.line</field>
        <field name="arch" type="xml">
            <form string="Run de publicacion" create="false">
                <header>
                    <button name="action_retry_run" string="Reintentar" type="object" class="btn-primary" invisible="status not in ['failed', 'skipped']"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="sku"/>
                        <h1>
                            <field name="sku" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="retailer" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                            <field name="max_attempts" readonly="1"/>
                        </group>
                        <group>
                            <field name="run_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="marketplace_publication_id" readonly="1"/>
                            <field name="external_product_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                        <field name="error_message" readonly="1"/>
                        <field name="error_code" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload API">
                            <field name="raw_payload_json" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_publisher_run_search" model="ir.ui.view">
        <field name="name">publisher.job.line.search</field>
        <field name="model">publisher.job.line</field>
        <field name="arch" type="xml">
            <search string="Buscar runs">
                <field name="sku"/>
                <field name="run_id"/>
                <field name="job_id"/>
                <filter name="queued" string="En cola" domain="[('status', '=', 'queued')]"/>
                <filter name="processing" string="Procesando" domain="[('status', 'in', ['processing', 'retrying'])]"/>
                <filter name="errors" string="Con error" domain="[('status', '=', 'failed')]"/>
                <filter name="completed" string="Completados" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_retailer" string="Marketplace" context="{'group_by': 'retailer'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_publisher_run" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">publisher.job.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_publisher_run_search"/>
    </record>

    <record id="view_publisher_job_search" model="ir.ui.view">
        <field name="name">publisher.job.search</field>
        <field name="model">publisher.job</field>
        <field name="arch" type="xml">
            <search string="Buscar procesos">
                <field name="name"/>
                <field name="backend_job_id"/>
                <filter name="active" string="En proceso" domain="[('status', 'in', ['queued', 'processing'])]"/>
                <filter name="errors" string="Con errores" domain="[('status', 'in', ['failed', 'completed_with_errors'])]"/>
                <filter name="completed" string="Completados" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sync_publisher_jobs" model="ir.actions.server">
        <field name="name">Sincronizar procesos</field>
        <field name="model_id" ref="model_publisher_job"/>
        <field name="binding_model_id" ref="model_publisher_job"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_recent_jobs()</field>
    </record>

    <record id="action_sync_publisher_runs" model="ir.actions.server">
        <field name="name">Sincronizar runs</field>
        <field name="model_id" ref="model_publisher_job_line"/>
        <field name="binding_model_id" ref="model_publisher_job_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_runs()</field>
    </record>
</odoo>
