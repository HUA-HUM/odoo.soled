<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sku_publisher_panel.CandidatesAction" owl="1">
        <div class="o_publisher_candidates_page">
            <div t-if="state.loading || state.publishing" class="o_publisher_loading_overlay">
                <div class="o_publisher_loading_box">
                    <span class="o_publisher_spinner"/>
                    <strong t-if="state.publishing">Enviando publicacion...</strong>
                    <strong t-else="">Cargando candidatos...</strong>
                    <small>Estamos consultando las APIs, puede tardar unos segundos.</small>
                </div>
            </div>

            <section class="o_publisher_candidates_header">
                <div>
                    <span class="o_publisher_eyebrow">Publicador SOLED</span>
                    <h2>Candidatos para publicar</h2>
                </div>
                <div class="o_publisher_candidates_header_meta">
                    <span><t t-esc="state.items.length"/> de <t t-esc="state.total"/> candidatos</span>
                    <span>Página <t t-esc="currentPage"/> / <t t-esc="totalPages"/></span>
                </div>
            </section>

            <section class="o_publisher_candidates_toolbar">
                <div class="o_publisher_candidates_toolbar_group">
                    <form t-on-submit="searchSku" class="o_publisher_candidates_search">
                        <label><i class="fa fa-search" aria-hidden="true"/> Buscar</label>
                        <div class="o_publisher_search_input">
                            <i class="fa fa-search o_publisher_search_icon" aria-hidden="true"/>
                            <input type="text" t-model="state.search" placeholder="SKU, titulo o MLA" t-att-disabled="state.loading || state.publishing"/>
                            <button
                                type="button"
                                class="o_publisher_search_clear"
                                t-if="state.search"
                                t-on-click="clearSearch"
                                t-att-disabled="state.loading || state.publishing"
                                aria-label="Limpiar busqueda"
                                title="Limpiar busqueda"
                            >
                                <i class="fa fa-times" aria-hidden="true"/>
                            </button>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.loading || state.publishing">Buscar</button>
                        </div>
                    </form>
                </div>
                <div class="o_publisher_candidates_toolbar_group is-actions">
                    <div class="o_publisher_candidates_bulk">
                        <label><i class="fa fa-cloud-upload" aria-hidden="true"/> Publicar en</label>
                        <div>
                            <button type="button" class="btn btn-secondary" t-on-click="selectPage" t-att-disabled="state.loading || state.publishing">
                                <t t-if="selectedSkus.length &amp;&amp; selectedSkus.length === state.items.length">Deseleccionar página</t>
                                <t t-else="">Seleccionar página</t>
                            </button>
                            <div class="o_publisher_select">
                                <select t-model="state.marketplace" t-att-disabled="state.loading || state.publishing">
                                    <option value="both">OnCity + Fravega</option>
                                    <option value="oncity">OnCity</option>
                                    <option value="fravega">Fravega</option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                            <button type="button" class="btn btn-primary o_publisher_publish_button" t-on-click="publishSelected" t-att-disabled="state.loading || state.publishing">
                                <t t-if="state.publishing"><i class="fa fa-spinner fa-spin me-1"/> Publicando...</t>
                                <t t-else=""><i class="fa fa-rocket me-1"/> Publicar <t t-esc="selectedSkus.length"/></t>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="o_publisher_filters_bar">
                    <span class="o_publisher_filters_bar__label"><i class="fa fa-sliders" aria-hidden="true"/> Filtros</span>
                    <div class="o_publisher_candidates_filters">
                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-tag" aria-hidden="true"/> Tipo</label>
                            <div t-attf-class="o_publisher_select #{state.filters.listingType !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.listingType" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Todos</option>
                                    <option t-foreach="state.options.listingTypes" t-as="option" t-key="option.value" t-att-value="option.value">
                                        <t t-esc="option.label"/> (<t t-esc="option.total"/>)
                                    </option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-bookmark" aria-hidden="true"/> Marca</label>
                            <div t-attf-class="o_publisher_select #{state.filters.brand !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.brand" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Todas</option>
                                    <option t-foreach="state.options.brands" t-as="option" t-key="option.value" t-att-value="option.value">
                                        <t t-esc="option.label"/> (<t t-esc="option.total"/>)
                                    </option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-sitemap" aria-hidden="true"/> Categoria</label>
                            <div t-attf-class="o_publisher_select #{state.filters.category !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.category" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Todas</option>
                                    <option t-foreach="state.options.categories" t-as="option" t-key="option.value" t-att-value="option.value">
                                        <t t-esc="option.label"/> (<t t-esc="option.total"/>)
                                    </option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-cubes" aria-hidden="true"/> Stock</label>
                            <div t-attf-class="o_publisher_select #{state.filters.stock !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.stock" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Todos</option>
                                    <option t-foreach="state.options.stock" t-as="option" t-key="option.value" t-att-value="option.value">
                                        <t t-esc="option.label"/> (<t t-esc="option.total"/>)
                                    </option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-signal" aria-hidden="true"/> Estado ML</label>
                            <div t-attf-class="o_publisher_select #{state.filters.status !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.status" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Todos</option>
                                    <option t-foreach="state.options.statuses" t-as="option" t-key="option.value" t-att-value="option.value">
                                        <t t-esc="option.label"/> (<t t-esc="option.total"/>)
                                    </option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-check-circle" aria-hidden="true"/> Publicado en</label>
                            <div t-attf-class="o_publisher_select #{state.filters.publishedIn !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.publishedIn" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Cualquiera</option>
                                    <option t-foreach="state.marketplaces" t-as="marketplace" t-key="marketplace" t-att-value="marketplace" t-esc="marketplaceLabel(marketplace)"/>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-ban" aria-hidden="true"/> Sin publicar en</label>
                            <div t-attf-class="o_publisher_select #{state.filters.notPublishedIn !== 'all' ? 'is-active' : ''}">
                                <select t-model="state.filters.notPublishedIn" t-on-change="changeFilter" t-att-disabled="state.loading || state.publishing">
                                    <option value="all">Cualquiera</option>
                                    <option t-foreach="state.marketplaces" t-as="marketplace" t-key="marketplace" t-att-value="marketplace" t-esc="marketplaceLabel(marketplace)"/>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>

                        <div class="o_publisher_candidates_filter">
                            <label><i class="fa fa-sort" aria-hidden="true"/> Orden</label>
                            <div class="o_publisher_select">
                                <select t-att-value="sortValue" t-on-change="changeSort" t-att-disabled="state.loading || state.publishing">
                                    <option value="updated_at:desc">Mas recientes</option>
                                    <option value="updated_at:asc">Mas antiguos</option>
                                    <option value="price:asc">Precio: menor a mayor</option>
                                    <option value="price:desc">Precio: mayor a menor</option>
                                    <option value="stock:desc">Mas stock</option>
                                    <option value="stock:asc">Menos stock</option>
                                    <option value="title:asc">Titulo A-Z</option>
                                    <option value="sku:asc">SKU A-Z</option>
                                </select>
                                <i class="fa fa-chevron-down o_publisher_select_caret" aria-hidden="true"/>
                            </div>
                        </div>
                    </div>
                    <button
                        type="button"
                        class="o_publisher_filters_clear"
                        t-if="hasActiveFilters"
                        t-on-click="resetFilters"
                        t-att-disabled="state.loading || state.publishing"
                    >
                        <i class="fa fa-undo" aria-hidden="true"/> Limpiar
                    </button>
                </div>
                <div class="o_publisher_active_chips" t-if="activeFilterChips.length">
                    <button
                        type="button"
                        class="o_publisher_chip"
                        t-foreach="activeFilterChips" t-as="chip" t-key="chip.key"
                        t-on-click="() => this.clearFilter(chip.key)"
                        t-att-disabled="state.loading || state.publishing"
                        t-attf-title="Quitar filtro {{chip.label}}"
                    >
                        <span class="o_publisher_chip__label" t-esc="chip.label"/>
                        <span class="o_publisher_chip__value" t-esc="chip.value"/>
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
            </section>

            <section t-if="state.loading &amp;&amp; !state.items.length" class="o_publisher_candidates_loading">
                <span class="o_publisher_spinner"/>
                <strong>Cargando candidatos...</strong>
            </section>

            <section t-elif="!state.loading &amp;&amp; !state.items.length" class="o_publisher_candidates_empty">
                <i class="fa fa-inbox" aria-hidden="true"/>
                <strong>No encontramos candidatos con estos filtros</strong>
                <small>Probá limpiar la búsqueda o cambiar el tipo de publicación.</small>
            </section>

            <section t-else="" class="o_publisher_candidates_grid">
                <article t-foreach="state.items" t-as="item" t-key="item.sku" t-attf-class="o_publisher_candidate_card #{state.selected[item.sku] ? 'is-selected' : ''}">
                    <label class="o_publisher_candidate_check">
                        <input type="checkbox" t-att-checked="state.selected[item.sku]" t-on-change="() => this.toggleSku(item.sku)"/>
                    </label>
                    <div class="o_publisher_candidate_media">
                        <img t-if="item.thumbnail" t-att-src="item.thumbnail" t-att-alt="item.sku"/>
                        <div t-else="" class="o_publisher_candidate_no_image">Sin imagen</div>
                    </div>
                    <div class="o_publisher_candidate_body">
                        <div class="o_publisher_candidate_top">
                            <strong t-esc="item.sku"/>
                            <span t-esc="item.status"/>
                        </div>
                        <div class="o_publisher_candidate_badges">
                            <span t-if="item.listing_type_id" t-esc="item.listing_type_id"/>
                            <span t-if="item.logistic_type" t-esc="item.logistic_type"/>
                        </div>
                        <div class="o_publisher_candidate_title" t-esc="item.title"/>
                        <div class="o_publisher_candidate_meta">
                            <span>$ <t t-esc="item.price"/></span>
                            <span>Stock <t t-esc="item.stock"/></span>
                            <span>Vendidos <t t-esc="item.sold_quantity || 0"/></span>
                        </div>
                        <div class="o_publisher_candidate_aggregate" t-if="item.publications">
                            <span t-if="formatPriceRange(item)" title="Rango de precios entre todas las publicaciones del SKU">
                                <i class="fa fa-arrows-h" aria-hidden="true"/> <t t-esc="formatPriceRange(item)"/>
                            </span>
                            <span title="Publicaciones del SKU en Mercado Libre">
                                <i class="fa fa-clone" aria-hidden="true"/> <t t-esc="item.publications"/> publicaciones<t t-if="item.premium_publications"> (<t t-esc="item.premium_publications"/> con cuotas)</t>
                            </span>
                        </div>
                        <div class="o_publisher_candidate_summary">
                            <span t-if="item.brand"><strong>Marca</strong><t t-esc="item.brand"/></span>
                            <span t-if="item.category_name"><strong>Categoria</strong><t t-esc="item.category_name"/></span>
                        </div>
                        <div class="o_publisher_candidate_marketplaces">
                            <span t-foreach="state.marketplaces" t-as="marketplace" t-key="marketplace"
                                  t-attf-class="#{isPublishedIn(item, marketplace) ? 'is-published' : 'is-pending'}"
                                  t-esc="marketplaceLabel(marketplace)"/>
                        </div>
                        <div class="o_publisher_candidate_actions">
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.openDetail(item.sku)">
                                <i class="fa fa-eye me-1" aria-hidden="true"/> Ver detalle
                            </button>
                            <button type="button" class="btn btn-secondary" t-if="item.permalink" t-on-click="() => this.openPermalink(item)">
                                <i class="fa fa-external-link me-1" aria-hidden="true"/> Abrir ML
                            </button>
                        </div>
                    </div>
                </article>
            </section>

            <section class="o_publisher_candidates_pager">
                <button type="button" class="btn btn-secondary" t-att-disabled="!hasPrevious" t-on-click="previousPage">
                    <i class="fa fa-chevron-left me-1" aria-hidden="true"/> Anterior
                </button>
                <span>
                    <t t-esc="state.offset + 1"/> - <t t-esc="Math.min(state.offset + state.limit, state.total)"/> de <t t-esc="state.total"/>
                </span>
                <button type="button" class="btn btn-secondary" t-att-disabled="!hasNext" t-on-click="nextPage">
                    Siguiente <i class="fa fa-chevron-right ms-1" aria-hidden="true"/>
                </button>
            </section>

            <div t-if="detailItem" class="o_publisher_modal_overlay" t-on-click="closeDetail">
                <div class="o_publisher_modal" t-on-click.stop="() => {}" role="dialog" aria-modal="true">
                    <header class="o_publisher_modal_header">
                        <div>
                            <span class="o_publisher_eyebrow" t-esc="detailItem.sku"/>
                            <h3 t-esc="detailItem.title || detailItem.sku"/>
                        </div>
                        <button type="button" class="o_publisher_modal_close" t-on-click="closeDetail" aria-label="Cerrar">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </header>
                    <div class="o_publisher_modal_body">
                        <div class="o_publisher_detail_top">
                            <div class="o_publisher_detail_media">
                                <img t-if="detailItem.thumbnail" t-att-src="detailItem.thumbnail" t-att-alt="detailItem.sku"/>
                                <div t-else="" class="o_publisher_candidate_no_image">Sin imagen</div>
                            </div>
                            <div class="o_publisher_detail_headline">
                                <div class="o_publisher_candidate_badges">
                                    <span t-if="detailItem.listing_type_id" t-esc="detailItem.listing_type_id"/>
                                    <span t-if="detailItem.logistic_type" t-esc="detailItem.logistic_type"/>
                                    <span t-if="detailItem.status" t-esc="detailItem.status"/>
                                </div>
                                <div class="o_publisher_candidate_meta">
                                    <span>$ <t t-esc="detailItem.price"/></span>
                                    <span>Stock <t t-esc="detailItem.stock"/></span>
                                    <span>Vendidos <t t-esc="detailItem.sold_quantity || 0"/></span>
                                </div>
                                <div class="o_publisher_candidate_marketplaces">
                                    <span t-foreach="state.marketplaces" t-as="marketplace" t-key="marketplace"
                                          t-attf-class="#{isPublishedIn(detailItem, marketplace) ? 'is-published' : 'is-pending'}"
                                          t-esc="marketplaceLabel(marketplace)"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_publisher_candidate_details">
                            <div><strong>SKU</strong><span t-esc="detailItem.sku"/></div>
                            <div><strong>ID ML</strong><span t-esc="detailItem.meli_item_id || '-'"/></div>
                            <div><strong>Marca</strong><span t-esc="detailItem.brand || '-'"/></div>
                            <div><strong>Categoria</strong><span t-esc="detailItem.category_name || '-'"/></div>
                            <div><strong>Seller</strong><span t-esc="detailItem.seller_id || '-'"/></div>
                            <div><strong>Condicion</strong><span t-esc="detailItem.condition_type || '-'"/></div>
                            <div><strong>Modelo</strong><span t-esc="detailItem.model || '-'"/></div>
                            <div><strong>GTIN</strong><span t-esc="detailItem.gtin || '-'"/></div>
                            <div><strong>Categoria ID</strong><span t-esc="detailItem.category_id || '-'"/></div>
                            <div><strong>Envio</strong><span t-esc="detailItem.shipping_mode || '-'"/></div>
                            <div><strong>Envio gratis</strong><span t-esc="formatBool(detailItem.free_shipping)"/></div>
                            <div><strong>Actualizado ML</strong><span t-esc="detailItem.updated_at || '-'"/></div>
                            <div class="is-wide" t-if="detailItem.description"><strong>Descripcion</strong><span t-esc="detailItem.description"/></div>
                            <details class="is-wide" t-if="detailItem.payload_json">
                                <summary>Payload candidato</summary>
                                <pre t-esc="detailItem.payload_json"/>
                            </details>
                        </div>
                    </div>
                    <footer class="o_publisher_modal_footer">
                        <label class="o_publisher_modal_select">
                            <input type="checkbox" t-att-checked="state.selected[detailItem.sku]" t-on-change="() => this.toggleSku(detailItem.sku)"/>
                            Incluir en selección para publicar
                        </label>
                        <div class="o_publisher_modal_footer_actions">
                            <button type="button" class="btn btn-secondary" t-if="detailItem.permalink" t-on-click="() => this.openPermalink(detailItem)">
                                <i class="fa fa-external-link me-1" aria-hidden="true"/> Abrir en ML
                            </button>
                            <button type="button" class="btn btn-primary" t-on-click="closeDetail">Cerrar</button>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
    </t>
</templates>
