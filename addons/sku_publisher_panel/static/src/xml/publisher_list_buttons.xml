<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sku_publisher_panel.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button t-if="props.resModel === 'publisher.sku'" type="button" class="btn o_publisher_list_refresh_button" t-on-click="onPublisherRefreshCandidates">
                <i class="fa fa-refresh me-1"/>
                Actualizar candidatos
            </button>
            <button t-if="props.resModel === 'publisher.sku'" type="button" class="btn o_publisher_list_secondary_button" t-on-click="() => this.onPublisherCreateJob('action_publish_oncity')">
                Publicar OnCity
            </button>
            <button t-if="props.resModel === 'publisher.sku'" type="button" class="btn o_publisher_list_secondary_button" t-on-click="() => this.onPublisherCreateJob('action_publish_fravega')">
                Publicar Fravega
            </button>
            <button t-if="props.resModel === 'publisher.sku'" type="button" class="btn o_publisher_list_secondary_button" t-on-click="() => this.onPublisherCreateJob('action_publish_both')">
                Publicar ambos
            </button>
            <button t-if="props.resModel === 'publisher.job'" type="button" class="btn o_publisher_list_refresh_button" t-on-click="onPublisherSyncJobs">
                <i class="fa fa-tasks me-1"/>
                Sincronizar procesos
            </button>
        </xpath>
    </t>
</templates>
