<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="marketplace_fravega" model="retailer.marketplace">
        <field name="name">Fravega</field>
        <field name="code">fravega</field>
        <field name="sequence">10</field>
        <field name="logo_url">/retailer_marketplace_panel/static/src/img/logofravega.png</field>
        <field name="status">available</field>
        <field name="description">Catálogo y órdenes conectados por API.</field>
    </record>

    <record id="marketplace_oncity" model="retailer.marketplace">
        <field name="name">OnCity</field>
        <field name="code">oncity</field>
        <field name="sequence">20</field>
        <field name="logo_url">/retailer_marketplace_panel/static/src/img/oncity_logo.png</field>
        <field name="status">available</field>
        <field name="description">Catálogo y órdenes conectados por API.</field>
    </record>

    <record id="retailer_dashboard_record" model="retailer.dashboard">
        <field name="name">Retailers</field>
    </record>

    <record id="view_retailer_dashboard_form" model="ir.ui.view">
        <field name="name">retailer.dashboard.form</field>
        <field name="model">retailer.dashboard</field>
        <field name="arch" type="xml">
            <form string="Retailers" create="false" edit="false">
                <sheet class="o_retailer_dashboard_sheet">
                    <div class="o_retailer_dashboard">
                        <section class="o_retailer_dashboard_hero">
                            <span>Retailers</span>
                            <h1>Operación de retailers</h1>
                        </section>

                        <section class="o_retailer_dashboard_grid">
                            <button name="action_open_marketplaces" type="object" class="o_retailer_dashboard_card">
                                <div class="o_retailer_dashboard_icon">
                                    <img src="/soled_dashboard_panel/static/src/img/retailers.svg" alt="Marketplaces"/>
                                </div>
                                <strong>Marketplaces</strong>
                                <span>Fravega, OnCity y próximos canales.</span>
                            </button>

                            <button name="action_open_publisher" type="object" class="o_retailer_dashboard_card">
                                <div class="o_retailer_dashboard_icon">
                                    <img src="/soled_dashboard_panel/static/src/img/publisher.webp" alt="Publicador"/>
                                </div>
                                <strong>Publicador</strong>
                                <span>SKUs candidatos, jobs y runs de publicación.</span>
                            </button>

                            <button name="action_open_updater" type="object" class="o_retailer_dashboard_card">
                                <div class="o_retailer_dashboard_icon o_retailer_dashboard_icon_font">
                                    <i class="fa fa-refresh" title="Actualizador"/>
                                </div>
                                <strong>Actualizador</strong>
                                <span>SKUs modificados y sus acciones de cambio por marketplace.</span>
                            </button>
                        </section>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retailer_marketplace_kanban" model="ir.ui.view">
        <field name="name">retailer.marketplace.kanban</field>
        <field name="model">retailer.marketplace</field>
        <field name="arch" type="xml">
            <kanban class="o_retailer_marketplace_kanban" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="code"/>
                <field name="logo_url"/>
                <field name="status"/>
                <field name="description"/>
                <field name="product_count"/>
                <field name="order_count"/>
                <field name="shipment_count"/>
                <field name="invoice_count"/>
                <field name="question_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_retailer_marketplace_card o_retailer_marketplace_#{record.code.raw_value}">
                            <div class="o_retailer_marketplace_logo_wrap">
                                <img t-att-src="record.logo_url.raw_value" t-att-alt="record.name.value" class="o_retailer_marketplace_logo"/>
                            </div>
                            <div class="o_retailer_marketplace_name">
                                <field name="name"/>
                            </div>
                            <span t-if="record.status.raw_value == 'available'" class="o_retailer_marketplace_status o_retailer_marketplace_status_available">Disponible</span>
                            <span t-if="record.status.raw_value == 'pending'" class="o_retailer_marketplace_status o_retailer_marketplace_status_pending">Pendiente</span>
                            <div class="o_retailer_marketplace_description">
                                <field name="description"/>
                            </div>
                            <div class="o_retailer_marketplace_count">
                                <strong><field name="product_count"/></strong>
                                <span>productos</span>
                            </div>
                            <div class="o_retailer_marketplace_actions">
                                <button name="action_open_catalog" type="object" class="btn o_retailer_marketplace_action">
                                    <i class="fa fa-cubes"/>
                                    Catálogo
                                </button>
                                <button name="action_open_orders" type="object" class="btn o_retailer_marketplace_action">
                                    <i class="fa fa-shopping-cart"/>
                                    Órdenes
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_retailer_marketplace_tree" model="ir.ui.view">
        <field name="name">retailer.marketplace.tree</field>
        <field name="model">retailer.marketplace</field>
        <field name="arch" type="xml">
            <tree string="Marketplaces" create="false" edit="false">
                <field name="name"/>
                <field name="status"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>

    <record id="view_retailer_marketplace_form" model="ir.ui.view">
        <field name="name">retailer.marketplace.form</field>
        <field name="model">retailer.marketplace</field>
        <field name="arch" type="xml">
            <form string="Marketplace" create="false" edit="false">
                <sheet class="o_retailer_marketplace_sheet">
                    <field name="code" invisible="1"/>
                    <field name="status" invisible="1"/>
                    <field name="product_count" invisible="1"/>
                    <field name="order_count" invisible="1"/>
                    <field name="shipment_count" invisible="1"/>
                    <field name="invoice_count" invisible="1"/>
                    <field name="question_count" invisible="1"/>

                    <div class="o_retailer_workspace">
                        <section class="o_retailer_hero">
                            <div class="o_retailer_hero_logo">
                                <img src="/retailer_marketplace_panel/static/src/img/oncity_logo.png" alt="OnCity" invisible="code != 'oncity'"/>
                                <img src="/retailer_marketplace_panel/static/src/img/logofravega.png" alt="Fravega" invisible="code != 'fravega'"/>
                            </div>
                            <div class="o_retailer_hero_content">
                                <div class="o_retailer_eyebrow">Marketplace</div>
                                <h1>
                                    <field name="name"/>
                                </h1>
                                <p>
                                    <field name="description"/>
                                </p>
                                <div class="o_retailer_hero_meta">
                                    <span class="o_retailer_status o_retailer_status_available" invisible="status != 'available'">Disponible</span>
                                    <span class="o_retailer_status o_retailer_status_pending" invisible="status != 'pending'">Pendiente</span>
                                    <span>Operación marketplace</span>
                                </div>
                            </div>
                        </section>

                        <section class="o_retailer_kpis">
                            <div class="o_retailer_kpi o_retailer_kpi_catalog">
                                <span class="o_retailer_kpi_label">Catálogo</span>
                                <strong><field name="product_count"/></strong>
                                <span>productos</span>
                            </div>
                            <div class="o_retailer_kpi o_retailer_kpi_orders">
                                <span class="o_retailer_kpi_label">Órdenes</span>
                                <strong><field name="order_count"/></strong>
                                <span>pendientes</span>
                            </div>
                            <div class="o_retailer_kpi o_retailer_kpi_shipments">
                                <span class="o_retailer_kpi_label">Envíos</span>
                                <strong><field name="shipment_count"/></strong>
                                <span>a gestionar</span>
                            </div>
                            <div class="o_retailer_kpi o_retailer_kpi_invoices">
                                <span class="o_retailer_kpi_label">Facturas</span>
                                <strong><field name="invoice_count"/></strong>
                                <span>pendientes</span>
                            </div>
                        </section>

                        <section class="o_retailer_sections">
                            <button name="action_open_catalog" type="object" class="o_retailer_section_card o_retailer_section_ready">
                                <i class="fa fa-cubes"/>
                                <span class="o_retailer_section_title">Catálogo</span>
                                <span class="o_retailer_section_text">Productos, stock, precios y publicaciones.</span>
                                <span class="o_retailer_section_metric"><field name="product_count"/> productos</span>
                            </button>
                            <button name="action_open_orders" type="object" class="o_retailer_section_card">
                                <i class="fa fa-shopping-cart"/>
                                <span class="o_retailer_section_title">Órdenes</span>
                                <span class="o_retailer_section_text">Ventas, estados de pago y preparación.</span>
                                <span class="o_retailer_section_metric"><field name="order_count"/> órdenes</span>
                            </button>
                            <button name="action_open_shipments" type="object" class="o_retailer_section_card">
                                <i class="fa fa-truck"/>
                                <span class="o_retailer_section_title">Envíos</span>
                                <span class="o_retailer_section_text">Despachos, etiquetas y seguimiento.</span>
                                <span class="o_retailer_section_metric">Próxima integración</span>
                            </button>
                            <button name="action_open_invoices" type="object" class="o_retailer_section_card">
                                <i class="fa fa-file-text-o"/>
                                <span class="o_retailer_section_title">Facturas</span>
                                <span class="o_retailer_section_text">Comprobantes y control administrativo.</span>
                                <span class="o_retailer_section_metric">Próxima integración</span>
                            </button>
                            <button name="action_open_questions" type="object" class="o_retailer_section_card">
                                <i class="fa fa-comments-o"/>
                                <span class="o_retailer_section_title">Preguntas</span>
                                <span class="o_retailer_section_text">Consultas de clientes y respuestas.</span>
                                <span class="o_retailer_section_metric">Próxima integración</span>
                            </button>
                            <button name="action_open_settings" type="object" class="o_retailer_section_card">
                                <i class="fa fa-sliders"/>
                                <span class="o_retailer_section_title">Configuración</span>
                                <span class="o_retailer_section_text">Credenciales, reglas y parámetros.</span>
                                <span class="o_retailer_section_metric">Próxima integración</span>
                            </button>
                        </section>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retailer_marketplace" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">retailer.marketplace</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('code', 'in', ['fravega', 'oncity'])]</field>
    </record>

    <record id="action_retailer_dashboard" model="ir.actions.act_window">
        <field name="name">Retailers</field>
        <field name="res_model">retailer.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_retailer_dashboard_form"/>
        <field name="res_id" ref="retailer_dashboard_record"/>
        <field name="target">current</field>
    </record>
</odoo>
