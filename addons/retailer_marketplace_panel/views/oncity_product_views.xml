<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_oncity_product_tree" model="ir.ui.view">
        <field name="name">retailer.oncity.product.tree</field>
        <field name="model">retailer.oncity.product</field>
        <field name="arch" type="xml">
            <tree string="Catalogo OnCity" create="false" decoration-danger="stock == 0" decoration-warning="stock &lt;= 2 and stock &gt; 0" decoration-muted="status != 'Activo'">
                <header>
                    <button name="action_sync_products" string="Actualizar catalogo" type="object" class="btn-primary"/>
                </header>
                <field name="link_publication" invisible="1"/>
                <button name="action_open_publication" string="Abrir" type="object" icon="fa-external-link" attrs="{'invisible': [('link_publication', '=', False)]}"/>
                <field name="seller_sku"/>
                <field name="title"/>
                <field name="status" widget="badge"/>
                <field name="price"/>
                <field name="stock"/>
                <field name="publication_id"/>
                <field name="market_sku"/>
                <field name="thumbnail" widget="url" optional="hide"/>
                <field name="synced_at"/>
            </tree>
        </field>
    </record>

    <record id="view_oncity_product_form" model="ir.ui.view">
        <field name="name">retailer.oncity.product.form</field>
        <field name="model">retailer.oncity.product</field>
        <field name="arch" type="xml">
            <form string="Producto OnCity" create="false">
                <header>
                    <button name="action_open_publication" string="Abrir publicacion" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1>
                            <field name="title" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificacion">
                            <field name="publication_id" readonly="1"/>
                            <field name="seller_sku" readonly="1"/>
                            <field name="market_sku" readonly="1"/>
                            <field name="link_publication" readonly="1" widget="url"/>
                        </group>
                        <group string="Estado comercial">
                            <field name="status" readonly="1"/>
                            <field name="price" readonly="1"/>
                            <field name="stock" readonly="1"/>
                            <field name="synced_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imagen principal">
                            <field name="thumbnail" readonly="1" widget="url"/>
                        </page>
                        <page string="Imagenes JSON">
                            <field name="images_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Payload JSON">
                            <field name="payload_json" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oncity_product_search" model="ir.ui.view">
        <field name="name">retailer.oncity.product.search</field>
        <field name="model">retailer.oncity.product</field>
        <field name="arch" type="xml">
            <search string="Buscar productos OnCity">
                <field name="seller_sku"/>
                <field name="title"/>
                <field name="market_sku"/>
                <field name="publication_id"/>
                <field name="status"/>
                <filter name="active" string="Activos" domain="[('status', '=', 'Activo')]"/>
                <filter name="paused" string="Pausados" domain="[('status', '=', 'Pausado')]"/>
                <filter name="with_stock" string="Con stock" domain="[('stock', '&gt;', 0)]"/>
                <filter name="low_stock" string="Stock bajo" domain="[('stock', '&gt;', 0), ('stock', '&lt;=', 2)]"/>
                <filter name="without_stock" string="Sin stock" domain="[('stock', '=', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oncity_product" model="ir.actions.act_window">
        <field name="name">OnCity</field>
        <field name="res_model">retailer.oncity.product</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_oncity_product_search"/>
    </record>

    <record id="action_sync_oncity_products" model="ir.actions.server">
        <field name="name">Actualizar catalogo OnCity</field>
        <field name="model_id" ref="model_retailer_oncity_product"/>
        <field name="binding_model_id" ref="model_retailer_oncity_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_products()</field>
    </record>
</odoo>
