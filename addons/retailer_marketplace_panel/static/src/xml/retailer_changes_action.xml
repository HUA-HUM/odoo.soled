<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="retailer_marketplace_panel.ChangesAction" owl="1">
        <div class="o_retailer_catalog_page o_retailer_changes_page">
            <div t-if="state.loading || state.syncingAll" class="o_retailer_catalog_loading_overlay">
                <div class="o_retailer_catalog_loading_box">
                    <span class="o_retailer_spinner"/>
                    <strong t-if="state.syncingAll">Sincronizando todos los cambios...</strong>
                    <strong t-else="">Actualizando cambios...</strong>
                    <small>Estamos consultando el servicio interno, puede tardar unos segundos.</small>
                </div>
            </div>

            <section class="o_retailer_changes_header">
                <div>
                    <span class="o_retailer_changes_eyebrow">Marketplaces</span>
                    <h1>Actualizador</h1>
                    <p>Monitoreá los cambios enviados a OnCity y Frávega.</p>
                </div>
                <div class="o_retailer_changes_kpis" aria-label="Resumen de la página actual">
                    <div class="o_retailer_changes_kpi">
                        <strong t-esc="state.total"/>
                        <span>Cambios</span>
                    </div>
                    <div class="o_retailer_changes_kpi is-success">
                        <strong t-esc="completedCount"/>
                        <span>Completados</span>
                    </div>
                    <div class="o_retailer_changes_kpi is-danger">
                        <strong t-esc="failedCount"/>
                        <span>Con error</span>
                    </div>
                </div>
            </section>

            <section class="o_retailer_catalog_toolbar">
                <form t-on-submit="searchChanges" class="o_retailer_catalog_search">
                    <label class="o_retailer_filter_field">
                        <span>SKU</span>
                        <input type="search" t-model="state.sku" placeholder="Ej. ABC-123" t-att-disabled="state.loading || state.syncingAll"/>
                    </label>
                    <label class="o_retailer_filter_field">
                        <span>Marketplace</span>
                        <select t-model="state.marketplace" t-att-disabled="state.loading || state.syncingAll">
                            <option value="">Todos los marketplaces</option>
                            <option value="oncity">OnCity</option>
                            <option value="fravega">Frávega</option>
                        </select>
                    </label>
                    <label class="o_retailer_filter_field">
                        <span>Estado</span>
                        <select t-model="state.status" t-att-disabled="state.loading || state.syncingAll">
                            <option value="">Todos los estados</option>
                            <option value="queued">Pendiente</option>
                            <option value="processing">Procesando</option>
                            <option value="completed">Completado</option>
                            <option value="failed">Con error</option>
                        </select>
                    </label>
                    <div class="o_retailer_filter_actions">
                        <button type="submit" class="btn btn-primary" t-att-disabled="state.loading || state.syncingAll">
                            <i class="fa fa-search me-1"/>Buscar
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="clearSearch" t-att-disabled="state.loading || state.syncingAll">Limpiar</button>
                    </div>
                </form>
                <div class="o_retailer_catalog_bulk">
                    <button type="button" class="btn o_retailer_catalog_refresh_button" t-on-click="() => this.loadPage()" t-att-disabled="state.loading || state.syncingAll">
                        <i class="fa fa-refresh me-1"/>Actualizar
                    </button>
                    <button type="button" class="btn o_retailer_catalog_secondary_button" t-on-click="syncAllChanges" t-att-disabled="state.loading || state.syncingAll">
                        <i class="fa fa-cloud-download me-1"/>Sincronizar todo
                    </button>
                </div>
            </section>

            <section t-if="state.error" class="o_retailer_changes_error" role="alert">
                <div><i class="fa fa-exclamation-circle"/><span t-esc="state.error"/></div>
                <button type="button" class="btn btn-sm btn-outline-danger" t-on-click="() => this.loadPage()">Reintentar</button>
            </section>

            <section class="o_retailer_catalog_meta">
                <span>Mostrando <t t-esc="state.items.length"/> de <t t-esc="state.total"/> cambios</span>
                <span>Página <t t-esc="currentPage"/> / <t t-esc="totalPages"/></span>
            </section>

            <section t-if="state.loading &amp;&amp; !state.items.length" class="o_retailer_catalog_empty">
                <span class="o_retailer_spinner"/><strong>Cargando cambios...</strong>
            </section>
            <section t-elif="!state.items.length &amp;&amp; !state.error" class="o_retailer_catalog_empty">
                <i class="fa fa-inbox o_retailer_empty_icon"/>
                <strong>No encontramos cambios.</strong>
                <small>Probá limpiar los filtros o sincronizar todo.</small>
            </section>

            <section t-if="state.items.length" class="o_retailer_change_grid">
                <article t-foreach="state.items" t-as="item" t-key="item.id" t-attf-class="o_retailer_change_card #{this.statusClass(item.status)}" t-on-click="() => this.openDetail(item)">
                    <div class="o_retailer_change_top">
                        <div><small>SKU</small><strong t-esc="item.sku || 'Sin SKU'"/></div>
                        <span t-attf-class="o_retailer_change_status #{this.statusClass(item.status)}" t-esc="this.statusLabel(item.status)"/>
                    </div>
                    <div class="o_retailer_change_badges">
                        <span t-attf-class="o_retailer_change_marketplace o_retailer_change_marketplace_#{item.marketplace || 'unknown'}" t-esc="item.marketplace || '—'"/>
                        <span t-if="item.change_type" class="o_retailer_change_type" t-esc="item.change_type"/>
                    </div>
                    <div t-if="item.summary" class="o_retailer_change_summary" t-esc="item.summary"/>
                    <div t-if="item.error_message" class="o_retailer_change_error" t-esc="item.error_message"/>
                    <div t-if="!item.summary &amp;&amp; (item.old_value || item.new_value)" class="o_retailer_change_comparison">
                        <div><span>Antes</span><strong t-esc="this.compactValue(item.old_value)"/></div>
                        <i class="fa fa-long-arrow-right" aria-hidden="true"/>
                        <div><span>Después</span><strong t-esc="this.compactValue(item.new_value)"/></div>
                    </div>
                    <div class="o_retailer_change_meta">
                        <span t-if="item.created_at"><i class="fa fa-clock-o me-1"/>Creado <t t-esc="this.formatDate(item.created_at)"/></span>
                        <span t-if="item.updated_at">Actualizado <t t-esc="this.formatDate(item.updated_at)"/></span>
                    </div>
                    <div class="o_retailer_change_actions">
                        <button type="button" class="btn btn-secondary" t-on-click.stop="() => this.openDetail(item)">Ver detalle <i class="fa fa-arrow-right ms-1"/></button>
                    </div>
                </article>
            </section>

            <section t-if="state.items.length" class="o_retailer_catalog_pager">
                <button type="button" class="btn btn-secondary" t-att-disabled="!hasPrevious" t-on-click="previousPage">Anterior</button>
                <span><t t-esc="state.offset + 1"/> - <t t-esc="Math.min(state.offset + state.limit, state.total)"/> de <t t-esc="state.total"/></span>
                <button type="button" class="btn btn-secondary" t-att-disabled="!hasNext" t-on-click="nextPage">Siguiente</button>
            </section>
        </div>
    </t>
</templates>
