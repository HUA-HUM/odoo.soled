<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="retailer_marketplace_panel.BulkActionsAction" owl="1">
        <div class="o_retailer_catalog_page o_retailer_bulk_page">
            <div t-if="isBusy" class="o_retailer_catalog_loading_overlay">
                <div class="o_retailer_catalog_loading_box">
                    <span class="o_retailer_spinner"/>
                    <strong t-if="state.runningReconciliation">Ejecutando la reconciliación...</strong>
                    <strong t-else="">Sincronizando el catálogo...</strong>
                    <small>Recorre todo el catálogo publicado, puede tardar varios minutos.</small>
                </div>
            </div>

            <section class="o_retailer_bulk_header">
                <div class="o_retailer_bulk_header__intro">
                    <span class="o_retailer_changes_eyebrow">Retailers</span>
                    <h1>Acciones masivas</h1>
                    <p>Procesos sobre todo el catálogo publicado y el historial de cada corrida.</p>
                </div>
                <div class="o_retailer_bulk_header__actions">
                    <button type="button" class="o_retailer_bulk_action is-primary" t-on-click="runReconciliationNow" t-att-disabled="isBusy">
                        <i t-attf-class="fa #{state.runningReconciliation ? 'fa-spinner fa-spin' : 'fa-refresh'}"/>
                        <span>
                            <strong>Reconciliar con MELI</strong>
                            <small>Pausa lo que ya no está activo</small>
                        </span>
                    </button>
                    <button type="button" class="o_retailer_bulk_action" t-on-click="runCatalogSyncNow" t-att-disabled="isBusy">
                        <i t-attf-class="fa #{state.runningSync ? 'fa-spinner fa-spin' : 'fa-cloud-download'}"/>
                        <span>
                            <strong>Sincronizar catálogo</strong>
                            <small>Trae OnCity y Frávega</small>
                        </span>
                    </button>
                </div>
            </section>

            <nav class="o_retailer_bulk_tabs" aria-label="Secciones de Acciones masivas">
                <button type="button" t-attf-class="o_retailer_bulk_tab #{state.activeTab === 'runs' ? 'is-active' : ''}" t-on-click="() => this.selectTab('runs')">
                    <i class="fa fa-history"/>Ejecuciones
                </button>
                <button type="button" t-attf-class="o_retailer_bulk_tab #{state.activeTab === 'catalog' ? 'is-active' : ''}" t-on-click="() => this.selectTab('catalog')">
                    <i class="fa fa-refresh"/>Actualizaciones de catálogo
                </button>
            </nav>

            <t t-if="state.activeTab === 'catalog'">
                <section class="o_retailer_sku_card">
                    <header>
                        <h2>Actualizar un SKU</h2>
                        <p>Consulta el estado real en MercadoLibre y encola la actualización en los marketplaces donde el SKU ya esté publicado.</p>
                    </header>

                    <form class="o_retailer_sku_form" t-on-submit="syncSku">
                        <label class="o_retailer_sku_field">
                            <span>SKU</span>
                            <input type="text" placeholder="Ej: JDXU1307" t-model="state.catalogForm.sku" t-att-disabled="state.catalogRunning"/>
                        </label>

                        <div class="o_retailer_sku_field">
                            <span>Marketplaces</span>
                            <div class="o_retailer_sku_options">
                                <button t-foreach="catalogMarketplaces" t-as="option" t-key="option.key" type="button"
                                        t-attf-class="o_retailer_sku_option #{state.catalogForm.marketplaces[option.key] ? 'is-on' : ''}"
                                        t-att-disabled="state.catalogRunning"
                                        t-on-click="() => this.toggleCatalogOption('marketplaces', option.key)">
                                    <i t-attf-class="fa #{state.catalogForm.marketplaces[option.key] ? 'fa-check-square-o' : 'fa-square-o'}"/>
                                    <t t-esc="option.label"/>
                                </button>
                            </div>
                        </div>

                        <div class="o_retailer_sku_field">
                            <span>Campos</span>
                            <div class="o_retailer_sku_options">
                                <button t-foreach="catalogFields" t-as="option" t-key="option.key" type="button"
                                        t-attf-class="o_retailer_sku_option #{state.catalogForm.fields[option.key] ? 'is-on' : ''}"
                                        t-att-disabled="state.catalogRunning"
                                        t-on-click="() => this.toggleCatalogOption('fields', option.key)">
                                    <i t-attf-class="fa #{state.catalogForm.fields[option.key] ? 'fa-check-square-o' : 'fa-square-o'}"/>
                                    <t t-esc="option.label"/>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="o_retailer_sku_submit" t-att-disabled="!canSyncSku">
                            <i t-attf-class="fa #{state.catalogRunning ? 'fa-spinner fa-spin' : 'fa-paper-plane-o'}"/>
                            <t t-if="state.catalogRunning">Encolando...</t>
                            <t t-else="">Encolar actualización</t>
                        </button>
                    </form>
                </section>

                <section t-if="state.catalogError" class="o_retailer_changes_error" role="alert">
                    <div><i class="fa fa-exclamation-circle"/><span t-esc="state.catalogError"/></div>
                </section>

                <section t-if="state.catalogResult" class="o_retailer_sku_result">
                    <header>
                        <h2>Resultado</h2>
                        <span class="o_retailer_sku_queued">
                            <t t-esc="state.catalogResult.actionsQueued"/>
                            <t t-if="state.catalogResult.actionsQueued === 1"> acción encolada</t>
                            <t t-else=""> acciones encoladas</t>
                        </span>
                    </header>

                    <dl class="o_retailer_sku_facts">
                        <div><dt>SKU</dt><dd t-esc="state.catalogResult.sku || '—'"/></div>
                        <div><dt>Item MELI</dt><dd t-esc="state.catalogResult.meliItemId || '—'"/></div>
                        <div><dt>Estado en MELI</dt><dd t-esc="state.catalogResult.meliStatus || '—'"/></div>
                        <div><dt>Fulfillment</dt><dd t-esc="state.catalogResult.isFulfillment ? 'Sí' : 'No'"/></div>
                    </dl>

                    <div class="o_retailer_sku_lists">
                        <div>
                            <span class="o_retailer_sku_list_title">Encolado en</span>
                            <div t-if="state.catalogResult.marketplacesQueued.length" class="o_retailer_sku_chips">
                                <span t-foreach="state.catalogResult.marketplacesQueued" t-as="marketplace" t-key="marketplace"
                                      class="is-queued" t-esc="marketplaceLabel(marketplace)"/>
                            </div>
                            <p t-else="" class="o_retailer_sku_muted">Ningún marketplace.</p>
                        </div>

                        <div t-if="state.catalogResult.skipped.length">
                            <span class="o_retailer_sku_list_title">Omitidos</span>
                            <ul class="o_retailer_sku_skipped">
                                <li t-foreach="state.catalogResult.skipped" t-as="entry" t-key="entry.marketplace">
                                    <strong t-esc="marketplaceLabel(entry.marketplace)"/>
                                    <small t-esc="entry.reason || 'Sin detalle'"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>
            </t>

            <t t-if="state.activeTab === 'runs'">
            <section t-if="state.runsError" class="o_retailer_changes_error" role="alert">
                <div><i class="fa fa-exclamation-circle"/><span t-esc="state.runsError"/></div>
            </section>

            <section class="o_retailer_runs_card">
                <header class="o_retailer_runs_card__head">
                    <div class="o_retailer_runs_card__title">
                        <h2>Ejecuciones</h2>
                        <span t-if="state.runsTotal" class="o_retailer_runs_count" t-esc="state.runsTotal"/>
                    </div>
                    <form class="o_retailer_runs_inline_filters" t-on-submit="applyRunsFilters">
                        <input type="text" placeholder="Proceso" t-model="state.runsFilters.processName" t-att-disabled="state.runsLoading"/>
                        <select t-model="state.runsFilters.status" t-on-change="applyRunsFilters" t-att-disabled="state.runsLoading">
                            <option value="">Todo estado</option>
                            <option value="running">Corriendo</option>
                            <option value="completed">Completado</option>
                            <option value="failed">Con error</option>
                        </select>
                        <select t-model="state.runsFilters.triggerType" t-on-change="applyRunsFilters" t-att-disabled="state.runsLoading">
                            <option value="">Todo disparo</option>
                            <option value="cron">Automático</option>
                            <option value="manual">Manual</option>
                            <option value="api">API</option>
                        </select>
                        <button type="button" t-if="hasRunsFilters" class="o_retailer_runs_clear" t-on-click="resetRunsFilters" t-att-disabled="state.runsLoading" title="Limpiar filtros">
                            <i class="fa fa-times"/>
                        </button>
                    </form>
                </header>

                <div t-if="state.runsLoading" class="o_retailer_runs_placeholder">
                    <span class="o_retailer_spinner"/>
                </div>

                <t t-else="">
                    <div t-if="state.runs.length" class="o_retailer_table_wrap">
                        <table class="o_retailer_runs_table">
                            <thead>
                                <tr>
                                    <th>Proceso</th>
                                    <th>Disparo</th>
                                    <th>Estado</th>
                                    <th>Inicio</th>
                                    <th class="is-numeric">Duración</th>
                                    <th>Resumen</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.runs" t-as="run" t-key="run.id">
                                    <td><strong t-esc="processLabel(run.processName)"/></td>
                                    <td class="is-muted" t-esc="triggerLabel(run.triggerType)"/>
                                    <td><span t-attf-class="o_retailer_runs_status #{statusClass(run.status)}" t-esc="statusLabel(run.status)"/></td>
                                    <td class="is-muted" t-esc="formatDate(run.startedAt)"/>
                                    <td class="is-numeric" t-esc="formatDuration(run.durationMs)"/>
                                    <td class="o_retailer_runs_summary" t-att-title="runSummaryText(run)" t-esc="runSummaryText(run)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div t-else="" class="o_retailer_runs_placeholder is-empty">
                        <i class="fa fa-inbox"/>
                        <strong>No hay ejecuciones para mostrar.</strong>
                        <small t-if="hasRunsFilters">Probá quitando los filtros.</small>
                        <small t-else="">Cuando corra un proceso, automático o manual, va a aparecer acá.</small>
                    </div>

                    <footer t-if="state.runs.length &amp;&amp; state.runsTotal > state.runsLimit" class="o_retailer_runs_card__foot">
                        <span><t t-esc="state.runsOffset + 1"/>–<t t-esc="Math.min(state.runsOffset + state.runsLimit, state.runsTotal)"/> de <t t-esc="state.runsTotal"/></span>
                        <div>
                            <button type="button" t-att-disabled="!runsHasPrevious" t-on-click="previousRunsPage"><i class="fa fa-chevron-left"/></button>
                            <button type="button" t-att-disabled="!runsHasNext" t-on-click="nextRunsPage"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </footer>
                </t>
            </section>
            </t>
        </div>
    </t>
</templates>
