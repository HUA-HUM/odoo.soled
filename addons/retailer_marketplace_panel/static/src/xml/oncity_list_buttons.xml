<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="retailer_marketplace_panel.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button t-if="props.resModel === 'retailer.oncity.product'" type="button" class="btn o_oncity_sync_button" t-on-click="onOncitySync">
                <i class="fa fa-refresh me-1"/>
                Actualizar catálogo
            </button>
            <button t-if="props.resModel === 'retailer.fravega.product'" type="button" class="btn o_oncity_sync_button" t-on-click="onFravegaSync">
                <i class="fa fa-refresh me-1"/>
                Actualizar catálogo
            </button>
            <button t-if="props.resModel === 'retailer.marketplace.order' &amp;&amp; props.context &amp;&amp; props.context.search_default_oncity" type="button" class="btn o_oncity_sync_button" t-on-click="onOncityOrdersSync">
                <i class="fa fa-refresh me-1"/>
                Actualizar órdenes
            </button>
            <button t-if="props.resModel === 'retailer.marketplace.order' &amp;&amp; props.context &amp;&amp; props.context.search_default_fravega" type="button" class="btn o_oncity_sync_button" t-on-click="onFravegaOrdersSync">
                <i class="fa fa-refresh me-1"/>
                Actualizar órdenes
            </button>
        </xpath>
    </t>
</templates>
