<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="base.main_company" model="res.company">
        <field name="logo" type="base64" file="soled_dashboard_panel/static/src/img/soled_login_logo.png"/>
    </record>

    <!-- El favicon va por codigo: base.main_company es noupdate, asi que un
         <field> aca solo se aplicaria al instalar el modulo, no al actualizar. -->
    <function model="soled.dashboard" name="_apply_brand_favicon"/>
</odoo>
