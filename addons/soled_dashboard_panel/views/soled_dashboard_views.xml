<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="soled_dashboard_record" model="soled.dashboard">
        <field name="name">Panel SOLED</field>
    </record>

    <record id="soled_dashboard_administration_record" model="soled.dashboard">
        <field name="name">Administracion</field>
    </record>

    <record id="soled_dashboard_commercial_record" model="soled.dashboard">
        <field name="name">Comercial</field>
    </record>

    <record id="soled_dashboard_configurations_record" model="soled.dashboard">
        <field name="name">Configuraciones</field>
    </record>

    <record id="view_soled_dashboard_home_form" model="ir.ui.view">
        <field name="name">soled.dashboard.home.form</field>
        <field name="model">soled.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel SOLED" create="false" edit="false">
                <sheet class="o_soled_dashboard_sheet">
                    <div class="o_soled_home">
                        <div class="o_soled_home_hero">
                            <img src="/ml_catalog_panel/static/src/img/soled_logo.png" alt="SOLED"/>
                            <div>
                                <span>Panel SOLED</span>
                                <h1>Elegir area de trabajo</h1>
                            </div>
                        </div>

                        <div class="o_soled_area_grid">
                            <button name="action_open_administration" type="object" class="o_soled_area_card o_soled_area_admin">
                                <i class="fa fa-building-o o_soled_area_icon"></i>
                                <span>Administracion</span>
                            </button>
                            <button name="action_open_commercial" type="object" class="o_soled_area_card o_soled_area_commercial">
                                <i class="fa fa-line-chart o_soled_area_icon"></i>
                                <span>Comercial</span>
                            </button>
                            <button name="action_open_configurations" type="object" class="o_soled_area_card o_soled_area_config">
                                <i class="fa fa-cog o_soled_area_icon"></i>
                                <span>Configuraciones</span>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soled_dashboard_administration_form" model="ir.ui.view">
        <field name="name">soled.dashboard.administration.form</field>
        <field name="model">soled.dashboard</field>
        <field name="arch" type="xml">
            <form string="Administracion" create="false" edit="false">
                <sheet class="o_soled_dashboard_sheet">
                    <div class="o_soled_area_page">
                        <div class="o_soled_area_header">
                            <button name="action_open_home" type="object" class="o_soled_back_button">Volver</button>
                            <div>
                                <span>Area</span>
                                <h1>Administracion</h1>
                            </div>
                        </div>
                        <div class="o_soled_placeholder_panel">
                            <strong>Administracion</strong>
                            <p>Esta seccion queda preparada para sumar procesos internos mas adelante.</p>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soled_dashboard_commercial_form" model="ir.ui.view">
        <field name="name">soled.dashboard.commercial.form</field>
        <field name="model">soled.dashboard</field>
        <field name="arch" type="xml">
            <form string="Comercial" create="false" edit="false">
                <sheet class="o_soled_dashboard_sheet">
                    <div class="o_soled_area_page">
                        <div class="o_soled_area_header">
                            <button name="action_open_home" type="object" class="o_soled_back_button">Volver</button>
                            <div>
                                <span>Area</span>
                                <h1>Comercial</h1>
                            </div>
                        </div>

                        <div class="o_soled_module_grid">
                            <button name="action_open_ml" type="object" class="o_soled_module_card o_soled_module_ml">
                                <div class="o_soled_module_logo">
                                    <img src="/soled_dashboard_panel/static/src/img/mercadolibre.svg" alt="MercadoLibre"/>
                                </div>
                                <strong>MercadoLibre</strong>
                            </button>
                            <button name="action_open_retailers" type="object" class="o_soled_module_card">
                                <div class="o_soled_module_logo">
                                    <img src="/soled_dashboard_panel/static/src/img/retailers.svg" alt="Retailers"/>
                                </div>
                                <strong>Retailers</strong>
                            </button>
                            <button name="action_open_coresa" type="object" class="o_soled_module_card">
                                <div class="o_soled_module_logo">
                                    <img src="/coresa_panel/static/src/img/coresa_logo.svg" alt="Coresa"/>
                                </div>
                                <strong>Coresa</strong>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soled_dashboard_configurations_form" model="ir.ui.view">
        <field name="name">soled.dashboard.configurations.form</field>
        <field name="model">soled.dashboard</field>
        <field name="arch" type="xml">
            <form string="Configuraciones" create="false" edit="false">
                <sheet class="o_soled_dashboard_sheet">
                    <div class="o_soled_area_page">
                        <div class="o_soled_area_header">
                            <button name="action_open_home" type="object" class="o_soled_back_button">Volver</button>
                            <div>
                                <span>Area</span>
                                <h1>Configuraciones</h1>
                            </div>
                        </div>

                        <div class="o_soled_module_grid">
                            <button name="action_open_invite_users" type="object" class="o_soled_module_card">
                                <div class="o_soled_text_logo">+</div>
                                <strong>Invitar usuarios</strong>
                            </button>
                            <button name="action_open_users" type="object" class="o_soled_module_card">
                                <div class="o_soled_text_logo">US</div>
                                <strong>Usuarios</strong>
                            </button>
                            <button name="action_open_companies" type="object" class="o_soled_module_card">
                                <div class="o_soled_text_logo">CO</div>
                                <strong>Companias</strong>
                            </button>
                            <button name="action_open_settings" type="object" class="o_soled_module_card">
                                <div class="o_soled_text_logo">AJ</div>
                                <strong>Ajustes</strong>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_soled_dashboard" model="ir.actions.act_window">
        <field name="name">Panel SOLED</field>
        <field name="res_model">soled.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_soled_dashboard_home_form"/>
        <field name="res_id" ref="soled_dashboard_record"/>
        <field name="target">current</field>
    </record>

    <record id="action_soled_dashboard_administration" model="ir.actions.act_window">
        <field name="name">Administracion</field>
        <field name="res_model">soled.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_soled_dashboard_administration_form"/>
        <field name="res_id" ref="soled_dashboard_administration_record"/>
        <field name="target">current</field>
    </record>

    <record id="action_soled_dashboard_commercial" model="ir.actions.act_window">
        <field name="name">Comercial</field>
        <field name="res_model">soled.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_soled_dashboard_commercial_form"/>
        <field name="res_id" ref="soled_dashboard_commercial_record"/>
        <field name="target">current</field>
    </record>

    <record id="action_soled_dashboard_configurations" model="ir.actions.act_window">
        <field name="name">Configuraciones</field>
        <field name="res_model">soled.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_soled_dashboard_configurations_form"/>
        <field name="res_id" ref="soled_dashboard_configurations_record"/>
        <field name="target">current</field>
    </record>
</odoo>
