<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Sin fallback a x_icon: ese trae el favicon de la compania en la base,
         que sigue siendo el de Odoo y ganaba en el webclient. -->
    <template id="soled_favicon_override" inherit_id="web.layout" name="SOLED Favicon">
        <!-- Las paginas que renderiza el server (login, sobre todo) titulaban
             "Odoo". El webclient ya se titula solo desde el sidebar. -->
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'SOLED Panel'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/png" rel="shortcut icon" href="/soled_dashboard_panel/static/src/img/soled_tab_icon.png"/>
            <link type="image/png" rel="icon" href="/soled_dashboard_panel/static/src/img/soled_tab_icon.png"/>
        </xpath>
    </template>

    <!-- El webclient declara ademas un icono de 192x192 (el de Odoo) sin pasar
         por x_icon, y Chrome elige ese para la pestaña porque es el mas grande
         que le sirve. Mientras estuviera, el favicon de arriba no se veia. -->
    <template id="soled_apple_touch_icon_override" inherit_id="web.webclient_bootstrap" name="SOLED App Icons">
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/soled_dashboard_panel/static/src/img/soled_app_icon_ios.png</attribute>
        </xpath>
        <xpath expr="//link[@rel='icon'][@sizes='192x192']" position="attributes">
            <attribute name="href">/soled_dashboard_panel/static/src/img/soled_icon_192.png</attribute>
        </xpath>
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content">#16283a</attribute>
        </xpath>
        <xpath expr="//meta[@name='msapplication-TileColor']" position="attributes">
            <attribute name="content">#16283a</attribute>
        </xpath>
        <xpath expr="//meta[@name='msapplication-navbutton-color']" position="attributes">
            <attribute name="content">#16283a</attribute>
        </xpath>
        <xpath expr="//meta[@name='msapplication-TileImage']" position="attributes">
            <attribute name="content">/soled_dashboard_panel/static/src/img/soled_icon_512.png</attribute>
        </xpath>
    </template>

    <template id="soled_login_logo_override" inherit_id="web.login_layout" name="SOLED Login Logo">
        <xpath expr="//img[contains(@t-attf-src, '/web/binary/company_logo')]" position="replace">
            <img
                src="/soled_dashboard_panel/static/src/img/soled_login_logo.png"
                alt="SOLED"
                style="display:block; max-height:120px; max-width:180px; width:auto; margin:0 auto;"
            />
        </xpath>
    </template>
</odoo>
