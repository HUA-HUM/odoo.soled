<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Un solo lugar donde se dibuja el trazo: los paths los pone el que llama. -->
    <t t-name="soled_dashboard_panel.SidebarGlyph" owl="1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path t-foreach="paths" t-as="glyph_d" t-key="glyph_d_index" t-att-d="glyph_d"/>
        </svg>
    </t>

    <t t-name="soled_dashboard_panel.GlobalSidebar" owl="1">
        <div class="o_soled_shell">
            <button t-if="previousItem" class="o_soled_global_back" type="button"
                    t-attf-title="Volver a {{previousItem.label}}"
                    t-on-click="goBack">
                <t t-call="soled_dashboard_panel.SidebarGlyph">
                    <t t-set="paths" t-value="glyph('back')"/>
                </t>
                <span t-esc="previousItem.label"/>
            </button>

            <aside t-attf-class="o_soled_global_sidebar #{state.collapsed ? 'is-collapsed' : ''}"
                   aria-label="Navegación del panel">
                <header class="o_soled_sidebar_brand">
                    <img src="/soled_dashboard_panel/static/src/img/soled_tab_icon.png" alt="SOLED"/>
                    <div class="o_soled_sidebar_brand__text">
                        <strong>SOLED</strong>
                        <span>Panel operativo</span>
                    </div>
                    <button type="button" class="o_soled_sidebar_collapse"
                            t-attf-title="#{state.collapsed ? 'Expandir' : 'Contraer'} el menú"
                            t-att-aria-label="state.collapsed ? 'Expandir el menú' : 'Contraer el menú'"
                            t-on-click="toggleCollapsed">
                        <t t-call="soled_dashboard_panel.SidebarGlyph">
                            <t t-set="paths" t-value="glyph(state.collapsed ? 'expand' : 'collapse')"/>
                        </t>
                    </button>
                </header>

                <nav class="o_soled_sidebar_navigation">
                    <t t-foreach="state.sections" t-as="section" t-key="section.key">
                        <span t-attf-class="o_soled_sidebar_section #{section_index > 0 ? 'o_soled_sidebar_section_split' : ''}"
                              t-esc="section.label"/>

                        <div t-foreach="section.items" t-as="item" t-key="item.key" class="o_soled_sidebar_group">
                            <div t-attf-class="o_soled_sidebar_link #{state.activeKey === item.key ? 'is-active' : ''} #{state.activeKey === item.key &amp;&amp; !state.activeChildKey ? 'is-current' : ''}">
                                <button type="button" class="o_soled_sidebar_link_main"
                                        t-attf-title="#{item.label}#{item.description ? ' — ' + item.description : ''}"
                                        t-on-click="() => this.openItem(item)">
                                    <span class="o_soled_sidebar_icon">
                                        <t t-call="soled_dashboard_panel.SidebarGlyph">
                                            <t t-set="paths" t-value="iconPaths(item)"/>
                                        </t>
                                    </span>
                                    <span class="o_soled_sidebar_copy">
                                        <strong t-esc="item.label"/>
                                        <small t-esc="item.description"/>
                                    </span>
                                </button>
                                <button t-if="hasChildren(item)" type="button" class="o_soled_sidebar_toggle"
                                        t-attf-title="#{isExpanded(item) ? 'Contraer' : 'Desplegar'} {{item.label}}"
                                        t-att-aria-expanded="isExpanded(item) ? 'true' : 'false'"
                                        t-on-click="(ev) => this.toggle(item, ev)">
                                    <t t-call="soled_dashboard_panel.SidebarGlyph">
                                        <t t-set="paths" t-value="glyph(isExpanded(item) ? 'chevronUp' : 'chevronDown')"/>
                                    </t>
                                </button>
                            </div>

                            <div t-if="hasChildren(item) &amp;&amp; isExpanded(item)" class="o_soled_sidebar_children">
                                <button t-foreach="item.children" t-as="child" t-key="child.key" type="button"
                                        t-attf-class="o_soled_sidebar_child #{state.activeChildKey === child.key ? 'is-current' : ''}"
                                        t-att-title="child.label"
                                        t-on-click="() => this.openItem(item, child)">
                                    <span class="o_soled_sidebar_child_dot"/>
                                    <span t-esc="child.label"/>
                                </button>
                            </div>
                        </div>
                    </t>
                </nav>

                <footer class="o_soled_sidebar_footer">
                    <div class="o_soled_sidebar_user">
                        <UserMenu/>
                    </div>
                    <div class="o_soled_sidebar_health">
                        <span class="o_soled_sidebar_status"/>
                        <span>Servicios activos</span>
                    </div>
                </footer>
            </aside>
        </div>
    </t>
</templates>
