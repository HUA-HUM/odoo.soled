<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ml_order_tree" model="ir.ui.view">
        <field name="name">ml.order.tree</field>
        <field name="model">ml.order</field>
        <field name="arch" type="xml">
            <tree string="Ordenes MercadoLibre" create="false">
                <header>
                    <button name="action_sync_orders" string="Actualizar ordenes" type="object" class="btn-primary"/>
                </header>
                <field name="external_id"/>
                <field name="status"/>
                <field name="buyer_nickname"/>
                <field name="total_amount"/>
                <field name="paid_amount"/>
                <field name="currency_id"/>
                <field name="item_count"/>
                <field name="date_created"/>
                <field name="date_closed"/>
            </tree>
        </field>
    </record>

    <record id="view_ml_order_form" model="ir.ui.view">
        <field name="name">ml.order.form</field>
        <field name="model">ml.order</field>
        <field name="arch" type="xml">
            <form string="Orden MercadoLibre" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <label for="external_id"/>
                        <h1><field name="external_id"/></h1>
                    </div>
                    <group>
                        <group string="Orden">
                            <field name="status"/>
                            <field name="buyer_nickname"/>
                            <field name="seller_id"/>
                            <field name="account_id"/>
                        </group>
                        <group string="Importes">
                            <field name="total_amount"/>
                            <field name="paid_amount"/>
                            <field name="currency_id"/>
                            <field name="item_count"/>
                        </group>
                    </group>
                    <group string="Fechas">
                        <field name="date_created"/>
                        <field name="date_closed"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ml_order_search" model="ir.ui.view">
        <field name="name">ml.order.search</field>
        <field name="model">ml.order</field>
        <field name="arch" type="xml">
            <search string="Buscar ordenes">
                <field name="external_id"/>
                <field name="buyer_nickname"/>
                <field name="status"/>
                <filter string="Pagadas" name="paid" domain="[('status', '=', 'paid')]"/>
                <filter string="Canceladas" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Comprador" name="group_buyer" context="{'group_by': 'buyer_nickname'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ml_order" model="ir.actions.act_window">
        <field name="name">Ordenes</field>
        <field name="res_model">ml.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ml_order_search"/>
    </record>
</odoo>
