<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ml_account_tree" model="ir.ui.view">
        <field name="name">ml.account.tree</field>
        <field name="model">ml.account</field>
        <field name="arch" type="xml">
            <tree string="Cuentas MercadoLibre">
                <field name="name"/>
                <field name="connected"/>
                <field name="seller_id"/>
                <field name="nickname"/>
                <field name="token_expires_at"/>
                <field name="last_connection_at"/>
            </tree>
        </field>
    </record>

    <record id="view_ml_account_form" model="ir.ui.view">
        <field name="name">ml.account.form</field>
        <field name="model">ml.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta MercadoLibre">
                <header>
                    <button name="action_connect" string="Conectar con MercadoLibre" type="object" class="btn-primary"/>
                    <button name="action_refresh_token" string="Actualizar token" type="object" attrs="{'invisible': [('refresh_token', '=', False)]}"/>
                    <button name="action_test_connection" string="Probar conexion" type="object" attrs="{'invisible': [('access_token', '=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="App MercadoLibre">
                            <field name="app_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group string="Cuenta conectada">
                            <field name="connected" readonly="1"/>
                            <field name="seller_id" readonly="1"/>
                            <field name="nickname" readonly="1"/>
                            <field name="token_expires_at" readonly="1"/>
                            <field name="last_connection_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tokens">
                            <group>
                                <field name="access_token" readonly="1" password="True"/>
                                <field name="refresh_token" readonly="1" password="True"/>
                            </group>
                        </page>
                        <page string="Instrucciones">
                            <div class="alert alert-info" role="alert">
                                <p>
                                    En MercadoLibre Developers, configura esta Redirect URI exactamente igual:
                                </p>
                                <p>
                                    <strong><field name="redirect_uri" readonly="1"/></strong>
                                </p>
                                <p>
                                    Luego completa App ID y Client Secret, guarda, y presiona Conectar con MercadoLibre.
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ml_account" model="ir.actions.act_window">
        <field name="name">Cuenta MercadoLibre</field>
        <field name="res_model">ml.account</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <template id="oauth_result" name="MercadoLibre OAuth Result">
        <html>
            <head>
                <title><t t-esc="title"/></title>
                <style>
                    body {
                        background: #f6f8f9;
                        color: #17303f;
                        font-family: Arial, Helvetica, sans-serif;
                        margin: 0;
                    }
                    .box {
                        background: #fff;
                        border: 1px solid #d8e0e5;
                        border-radius: 8px;
                        box-shadow: 0 10px 28px rgba(23, 48, 63, 0.12);
                        margin: 12vh auto;
                        max-width: 560px;
                        padding: 32px;
                    }
                    h1 {
                        margin: 0 0 12px;
                    }
                    p {
                        line-height: 1.45;
                    }
                    a {
                        color: #f65359;
                        font-weight: 700;
                    }
                </style>
            </head>
            <body>
                <main class="box">
                    <h1><t t-esc="title"/></h1>
                    <p><t t-esc="message"/></p>
                    <p><a href="/web">Volver a Odoo</a></p>
                </main>
            </body>
        </html>
    </template>
</odoo>
