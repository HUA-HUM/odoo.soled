<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- La portada dejo de ser un form de Odoo: ahora es una accion cliente,
         para poder mostrar los contadores en vivo. El xmlid es nuevo a
         proposito: Odoo no deja reusar uno entre modelos distintos. -->
    <record id="action_coresa_dashboard_panel" model="ir.actions.client">
        <field name="name">Coresa</field>
        <field name="tag">coresa_panel.dashboard_action</field>
    </record>

    <record id="action_coresa_catalog" model="ir.actions.client">
        <field name="name">Catálogo Coresa</field>
        <field name="tag">coresa_panel.catalog_action</field>
    </record>
</odoo>
