<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_coresa_publication_form" model="ir.ui.view">
        <field name="name">coresa.publication.form</field>
        <field name="model">coresa.publication</field>
        <field name="arch" type="xml">
            <form string="Publicacion Coresa" create="false" class="o_coresa_form">
                <header>
                    <button name="action_publish" type="object" string="Publicar en MercadoLibre"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('can_publish', '=', False), ('state', 'in', ('published', 'discarded'))]}"/>
                    <button name="action_rebuild_draft" type="object" string="Volver a armar borrador"
                            attrs="{'invisible': [('state', 'in', ('published', 'discarded', 'publishing'))]}"/>
                    <button name="action_discard" type="object" string="Descartar"
                            attrs="{'invisible': [('state', 'in', ('published', 'discarded'))]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,published"/>
                </header>
                <sheet>
                    <field name="can_publish" invisible="1"/>
                    <field name="has_missing" invisible="1"/>
                    <field name="has_validation" invisible="1"/>
                    <field name="has_error" invisible="1"/>
                    <field name="has_picture" invisible="1"/>
                    <field name="has_result" invisible="1"/>

                    <div class="o_coresa_alerts">
                        <div class="alert alert-warning" role="alert"
                             attrs="{'invisible': [('has_missing', '=', False)]}">
                            <strong><i class="fa fa-info-circle"/> Atributos sin completar: </strong>
                            <field name="missing_attributes" readonly="1" nolabel="1" class="oe_inline"/>
                            <div class="o_coresa_alert_hint">Si el estado es "Listo para publicar",
                                MercadoLibre los marcó como recomendados y se puede publicar igual.</div>
                        </div>
                        <div class="alert alert-warning" role="alert"
                             attrs="{'invisible': [('has_validation', '=', False)]}">
                            <strong><i class="fa fa-exclamation-triangle"/> MercadoLibre rechazó el borrador</strong>
                            <field name="validation_message" readonly="1" nolabel="1"/>
                        </div>
                        <div class="alert alert-danger" role="alert"
                             attrs="{'invisible': [('has_error', '=', False)]}">
                            <strong><i class="fa fa-times-circle"/> Error al publicar</strong>
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </div>
                        <div class="alert alert-info" role="alert"
                             attrs="{'invisible': [('blocking_reason', '=', False)]}">
                            <field name="blocking_reason" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <div class="oe_title o_coresa_title_block">
                        <span class="o_coresa_sku"><field name="sku" readonly="1" nolabel="1" class="oe_inline"/></span>
                        <h1><field name="family_name" placeholder="Título en MercadoLibre" nolabel="1"/></h1>
                        <div class="o_coresa_title_meta">
                            <span>Máximo 60 caracteres · usados <field name="title_length" readonly="1" nolabel="1" class="oe_inline"/></span>
                        </div>
                    </div>

                    <div class="o_coresa_editor">
                        <div class="o_coresa_editor__main">
                            <group string="Precio y stock" col="4">
                                <field name="price"/>
                                <field name="available_quantity"/>
                            </group>

                            <group string="Descripción">
                                <field name="description" nolabel="1" placeholder="Texto plano: MercadoLibre no acepta HTML."/>
                            </group>

                            <notebook>
                                <page string="Atributos">
                                    <field name="attribute_ids">
                                        <tree editable="bottom" create="false" delete="false"
                                              decoration-danger="missing == True">
                                            <field name="missing" invisible="1"/>
                                            <field name="name"/>
                                            <field name="value"/>
                                            <field name="allowed_values"/>
                                            <field name="required"/>
                                            <field name="attribute_id_ml" optional="hide"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Categorías sugeridas">
                                    <div class="alert alert-info" role="alert">
                                        Cambiar de categoría rehace el borrador: cada categoría tiene
                                        sus propios atributos obligatorios.
                                    </div>
                                    <field name="category_suggestion_ids">
                                        <tree create="false" delete="false">
                                            <field name="name"/>
                                            <field name="domain_name"/>
                                            <field name="category_id_ml"/>
                                            <button name="action_use_category" type="object"
                                                    string="Usar" icon="fa-refresh"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Datos de Coresa">
                                    <field name="coresa_snapshot_json" widget="ace"
                                           options="{'mode': 'json'}" nolabel="1" readonly="1"/>
                                </page>
                            </notebook>
                        </div>

                        <div class="o_coresa_editor__aside">
                            <div class="o_coresa_aside_card" attrs="{'invisible': [('has_picture', '=', False)]}">
                                <span class="o_coresa_aside_title">Imagen</span>
                                <field name="picture_url" widget="image_url" nolabel="1"
                                       options="{'size': [260, 260]}" readonly="1"/>
                            </div>

                            <div class="o_coresa_aside_card">
                                <span class="o_coresa_aside_title">Origen del contenido</span>
                                <group>
                                    <field name="category_id_ml"/>
                                    <field name="category_name" attrs="{'invisible': [('category_name', '=', False)]}"/>
                                    <field name="ai_model" attrs="{'invisible': [('ai_model', '=', False)]}"/>
                                    <field name="ai_generated_at" attrs="{'invisible': [('ai_generated_at', '=', False)]}"/>
                                </group>
                                <div class="o_coresa_aside_hint">Título, descripción y atributos los
                                    genera la IA. Precio y stock salen de Coresa.</div>
                            </div>

                            <div class="o_coresa_aside_card" attrs="{'invisible': [('has_result', '=', False)]}">
                                <span class="o_coresa_aside_title">En MercadoLibre</span>
                                <group>
                                    <field name="classic_item_id"/>
                                    <field name="premium_item_id"/>
                                    <field name="permalink" widget="url"/>
                                </group>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coresa_publication_tree" model="ir.ui.view">
        <field name="name">coresa.publication.tree</field>
        <field name="model">coresa.publication</field>
        <field name="arch" type="xml">
            <tree string="Publicaciones Coresa" create="false"
                  decoration-success="state == 'published'"
                  decoration-warning="state == 'partial'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'discarded'">
                <field name="sku"/>
                <field name="family_name"/>
                <field name="state"/>
                <field name="price"/>
                <field name="available_quantity"/>
                <field name="classic_item_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_coresa_publication_search" model="ir.ui.view">
        <field name="name">coresa.publication.search</field>
        <field name="model">coresa.publication</field>
        <field name="arch" type="xml">
            <search string="Publicaciones">
                <field name="sku"/>
                <field name="family_name"/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_ready" string="Listo" domain="[('state', '=', 'ready')]"/>
                <filter name="filter_published" string="Publicado" domain="[('state', '=', 'published')]"/>
                <filter name="filter_partial" string="Parcial" domain="[('state', '=', 'partial')]"/>
                <filter name="filter_failed" string="Con error" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- El listado se lee en vivo de coresa-api; la tabla local es solo el
         espejo que alimenta el editor del borrador. -->
    <record id="action_coresa_publications_panel" model="ir.actions.client">
        <field name="name">Publicaciones</field>
        <field name="tag">coresa_meli_publisher.publications_action</field>
    </record>

    <record id="action_coresa_publication" model="ir.actions.act_window">
        <field name="name">Borradores locales</field>
        <field name="res_model">coresa.publication</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
