<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="coresa_meli_publisher.PublisherAction" owl="1">
        <div class="o_cpub_page">
            <PublicationEditor t-if="state.editingId" publicationId="state.editingId" onClose.bind="closeEditor"/>

            <t t-else="">
            <section class="o_cpub_header">
                <div>
                    <span class="o_cpub_eyebrow">Coresa</span>
                    <h1>Publicador</h1>
                    <p>Armá el borrador de un SKU, mirá cómo queda y qué dice MercadoLibre antes de mandarlo.</p>
                </div>
            </section>

            <nav class="o_cpub_tabs">
                <button type="button" t-attf-class="o_cpub_tab #{state.tab === 'preview' ? 'is-active' : ''}"
                        t-on-click="() => this.setTab('preview')">
                    <i class="fa fa-eye"/> Previsualizar
                </button>
                <button type="button" t-attf-class="o_cpub_tab #{state.tab === 'queue' ? 'is-active' : ''}"
                        t-on-click="() => this.setTab('queue')">
                    <i class="fa fa-paper-plane-o"/> Publicador
                </button>
                <button type="button" t-attf-class="o_cpub_tab #{state.tab === 'registry' ? 'is-active' : ''}"
                        t-on-click="() => this.setTab('registry')">
                    <i class="fa fa-history"/> Registros
                </button>
            </nav>

            <PublisherPreviewTab t-if="state.tab === 'preview'" sku="state.previewSku"/>
            <PublisherQueueTab t-elif="state.tab === 'queue'" onPreview.bind="openPreview" onEdit.bind="openEditor"/>
            <PublicationsEmbedded t-else="" onOpen.bind="openEditor"/>
            </t>
        </div>
    </t>

    <t t-name="coresa_meli_publisher.PublisherPreviewTab" owl="1">
        <div class="o_cpub_tabpane">
            <form class="o_cpub_search" t-on-submit="submit">
                <label class="o_cpub_field">
                    <span>SKU de Coresa</span>
                    <input type="text" placeholder="Ej: AEB 35 SC/1" t-model="state.sku" t-att-disabled="state.loading"/>
                </label>
                <button type="submit" class="o_cpub_primary" t-att-disabled="state.loading">
                    <i t-attf-class="fa #{state.loading ? 'fa-spinner fa-spin' : 'fa-magic'}"/>
                    <span t-esc="state.loading ? 'Armando...' : 'Previsualizar'"/>
                </button>
                <small>Consulta el catálogo de Coresa, pide categoría y validación a MercadoLibre y redacta el aviso. Suele tardar unos segundos.</small>
            </form>

            <section t-if="state.error" class="o_cpub_state is-error" role="alert">
                <i class="fa fa-exclamation-circle"/>
                <strong t-esc="state.error"/>
            </section>

            <section t-elif="state.loading" class="o_cpub_state">
                <i class="fa fa-spinner fa-spin"/>
                <strong>Armando el borrador...</strong>
                <span>Es una cadena de llamadas: Coresa, MercadoLibre y la redacción.</span>
            </section>

            <section t-elif="!hasResult" class="o_cpub_state">
                <i class="fa fa-eye"/>
                <strong>Todavía no previsualizaste nada.</strong>
                <span>Poné un SKU y se arma el borrador sin publicar nada.</span>
            </section>

            <t t-else="">
                <!-- Lo primero: si se puede publicar o no, y por qué. -->
                <section t-attf-class="o_cpub_verdict #{anyValid ? 'is-ok' : 'is-bad'}">
                    <div class="o_cpub_verdict__head">
                        <i t-attf-class="fa #{anyValid ? 'fa-check-circle' : 'fa-times-circle'}"/>
                        <div>
                            <strong t-if="anyValid">MercadoLibre acepta el borrador.</strong>
                            <strong t-else="">MercadoLibre rechaza el borrador.</strong>
                            <span>
                                SKU <b t-esc="state.data.sku"/> ·
                                borrador #<b t-esc="state.data.publicationId"/> ·
                                <b t-esc="statusLabel(state.data.status)"/>
                            </span>
                        </div>
                    </div>

                    <div t-foreach="state.data.validation" t-as="row" t-key="row.listingType" class="o_cpub_valrow">
                        <span t-attf-class="o_cpub_pill #{row.valid ? 'is-green' : 'is-red'}">
                            <t t-esc="listingLabel(row.listingType)"/>:
                            <t t-esc="row.valid ? 'válida' : 'rechazada'"/>
                        </span>
                        <ul t-if="row.causes.length" class="o_cpub_causes">
                            <li t-foreach="row.causes" t-as="cause" t-key="cause_index" t-esc="cause"/>
                        </ul>
                        <!-- Las advertencias no frenan la publicacion: conviene
                             que se note, porque aparecen incluso cuando valida. -->
                        <small t-if="row.warnings.length" class="o_cpub_warnlabel">Advertencias, no bloquean:</small>
                        <ul t-if="row.warnings.length" class="o_cpub_warnings">
                            <li t-foreach="row.warnings" t-as="warning" t-key="warning_index" t-esc="warning"/>
                        </ul>
                    </div>

                    <p t-if="state.data.missing.length" class="o_cpub_missing">
                        <i class="fa fa-exclamation-triangle"/>
                        MercadoLibre pide estos atributos para esta categoría y el borrador no los trae:
                        <b t-foreach="state.data.missing" t-as="attribute" t-key="attribute">
                            <t t-esc="attribute"/><t t-if="!attribute_last">, </t>
                        </b>
                    </p>
                </section>

                <!-- La categoria manda: cada una pide otros atributos. -->
                <section class="o_cpub_block">
                    <h3>Categoría</h3>
                    <p class="o_cpub_hint">Cada categoría tiene sus propios atributos obligatorios. Si elegís otra, el borrador se arma de nuevo.</p>
                    <div class="o_cpub_cats">
                        <button t-foreach="state.data.suggestions" t-as="suggestion" t-key="suggestion.id" type="button"
                                t-attf-class="o_cpub_cat #{suggestion.id === state.data.categoryId ? 'is-active' : ''}"
                                t-att-disabled="state.loading"
                                t-on-click="() => this.useCategory(suggestion.id)">
                            <strong t-esc="suggestion.name"/>
                            <small t-esc="suggestion.domain"/>
                            <code t-esc="suggestion.id"/>
                        </button>
                    </div>
                </section>

                <section class="o_cpub_block">
                    <h3>El aviso</h3>
                    <div class="o_cpub_draft">
                        <div class="o_cpub_draft__media">
                            <t t-if="state.data.draft.pictures.length">
                                <!-- Parte del bucket de Coresa responde 403: la que no
                                     carga se esconde en vez de dejar el icono roto. -->
                                <img t-foreach="state.data.draft.pictures" t-as="picture" t-key="picture"
                                     t-att-src="picture" t-att-alt="state.data.sku"
                                     t-on-error="(ev) => ev.target.classList.add('is-failed')"
                                     t-on-click="() => this.openPicture(picture)"/>
                            </t>
                            <div t-else="" class="o_cpub_noimg"><i class="fa fa-image"/><small>Sin fotos</small></div>
                        </div>

                        <div class="o_cpub_draft__body">
                            <h4 t-esc="state.data.draft.title"/>
                            <div class="o_cpub_price">
                                <strong t-esc="formatMoney(state.data.draft.price)"/>
                                <span><t t-esc="formatUnits(state.data.draft.quantity)"/> disponibles</span>
                            </div>
                            <dl class="o_cpub_pairs">
                                <div><dt>Condición</dt><dd t-esc="conditionLabel(state.data.draft.condition)"/></div>
                                <div><dt>Envío</dt><dd t-esc="shippingLabel(state.data.draft.shipping)"/></div>
                                <div>
                                    <dt>Tipo de publicación</dt>
                                    <dd>
                                        <t t-foreach="state.data.draft.listingTypes" t-as="listing" t-key="listing">
                                            <t t-esc="listingLabel(listing)"/><t t-if="!listing_last">, </t>
                                        </t>
                                    </dd>
                                </div>
                                <div><dt>Categoría</dt><dd t-esc="state.data.categoryName || state.data.categoryId"/></div>
                            </dl>
                        </div>
                    </div>
                </section>

                <section class="o_cpub_block">
                    <h3>Descripción</h3>
                    <div t-attf-class="o_cpub_description #{state.descriptionOpen ? 'is-open' : ''}">
                        <p t-esc="state.data.draft.description"/>
                    </div>
                    <button type="button" class="o_cpub_more" t-on-click="toggleDescription">
                        <t t-esc="state.descriptionOpen ? 'Ver menos' : 'Ver todo'"/>
                    </button>
                </section>

                <section class="o_cpub_block">
                    <h3>Atributos</h3>
                    <div class="o_cpub_attrs">
                        <div t-foreach="state.data.draft.attributes" t-as="attribute" t-key="attribute.id" class="o_cpub_attr">
                            <code t-esc="attribute.id"/>
                            <span t-esc="attribute.value"/>
                        </div>
                        <div t-foreach="state.data.missing" t-as="missing" t-key="missing" class="o_cpub_attr is-missing">
                            <code t-esc="missing"/>
                            <span>falta</span>
                        </div>
                    </div>
                </section>

                <section t-if="state.data.draft.saleTerms.length" class="o_cpub_block">
                    <h3>Garantía y condiciones</h3>
                    <div class="o_cpub_attrs">
                        <div t-foreach="state.data.draft.saleTerms" t-as="term" t-key="term.id" class="o_cpub_attr">
                            <code t-esc="term.id"/>
                            <span t-esc="term.value"/>
                        </div>
                    </div>
                </section>

                <p class="o_cpub_foot">
                    Previsualizar no publica nada. Coresa guarda el borrador con el número de arriba.
                </p>
            </t>
        </div>
    </t>

    <!-- Pestaña 2: la cola, lo que todavia no se mando. -->
    <t t-name="coresa_meli_publisher.PublisherQueueTab" owl="1">
        <div class="o_cpub_tabpane">
            <p class="o_cpub_lead">
                Solo lo que MercadoLibre ya aceptó. Elegí lo que quieras mandar: se publican de a una,
                en orden, y se ve el avance. Lo que está en borrador se corrige desde Registros.
            </p>

            <section t-if="state.error" class="o_cpub_state is-error" role="alert">
                <i class="fa fa-exclamation-circle"/>
                <strong t-esc="state.error"/>
            </section>

            <section t-elif="state.loading" class="o_cpub_state">
                <i class="fa fa-spinner fa-spin"/>
                <strong>Buscando borradores...</strong>
            </section>

            <t t-else="">
                <div class="o_cpub_queuebar">
                    <label t-if="state.items.length" class="o_cpub_checkall">
                        <input type="checkbox" t-att-checked="allSelected" t-att-disabled="state.run.active"
                               t-on-change="toggleAll"/>
                        <span>Seleccionar todo</span>
                    </label>
                    <span><b t-esc="counterFor('ready')"/> listos para publicar</span>
                    <span t-if="selectedIds.length"><b t-esc="selectedIds.length"/> seleccionados</span>
                    <button type="button" class="o_cpub_more" t-att-disabled="state.run.active" t-on-click="load">Actualizar</button>
                    <button type="button" class="o_cpub_primary" t-att-disabled="state.run.active || !selectedIds.length"
                            t-on-click="publishSelected">
                        <i class="fa fa-paper-plane"/>
                        <span>Mandar a publicar</span>
                    </button>
                </div>

                <!-- El avance del envio. Se corta despues de la que esta en curso. -->
                <section t-if="state.run.total" class="o_cpub_run">
                    <div class="o_cpub_run__head">
                        <strong t-if="state.run.active">Publicando <t t-esc="state.run.done + 1"/> de <t t-esc="state.run.total"/>...</strong>
                        <strong t-else="">Listo: <t t-esc="runSummary.done"/> publicadas<t t-if="runSummary.failed">, <t t-esc="runSummary.failed"/> con error</t></strong>
                        <button t-if="state.run.active" type="button" class="o_cpub_more" t-att-disabled="state.run.cancel"
                                t-on-click="cancelRun">
                            <t t-esc="state.run.cancel ? 'Cortando...' : 'Cortar'"/>
                        </button>
                    </div>
                    <div class="o_cpub_bar"><span t-attf-style="width: #{progressPercent}%"/></div>
                    <small t-if="state.run.active">Cada publicación tarda entre 10 y 40 segundos. No cierres la pestaña.</small>
                    <small t-else="">Las publicadas siguen acá con su link hasta que toques Actualizar.</small>
                </section>

                <section t-if="state.items.length" class="o_cpub_queue">
                    <article t-foreach="state.items" t-as="row" t-key="row.id"
                             t-attf-class="o_cpub_qcard #{state.selected[row.id] ? 'is-picked' : ''} #{resultFor(row) ? 'is-' + resultFor(row).state : ''}">
                        <header>
                            <label class="o_cpub_pick">
                                <input type="checkbox" t-att-checked="state.selected[row.id]"
                                       t-att-disabled="state.run.active" t-on-change="() => this.toggle(row)"/>
                            </label>
                            <span t-attf-class="o_cpub_pill #{row.status === 'ready' ? 'is-green' : 'is-gray'}"
                                  t-esc="statusLabel(row.status)"/>
                            <code t-esc="row.sku"/>
                            <span t-if="resultFor(row)" t-attf-class="o_cpub_resu is-#{resultFor(row).state}">
                                <i t-if="resultFor(row).state === 'publishing'" class="fa fa-spinner fa-spin"/>
                                <t t-esc="resultLabel(resultFor(row).state)"/>
                            </span>
                        </header>
                        <h4 t-esc="row.title || 'Sin título'"/>
                        <dl class="o_cpub_pairs">
                            <div><dt>Precio</dt><dd t-esc="formatMoney(row.price)"/></div>
                            <div><dt>Stock</dt><dd t-esc="formatUnits(row.availableQuantity)"/></div>
                            <div><dt>Categoría</dt><dd t-esc="row.categoryId || '—'"/></div>
                            <div><dt>Pedido por</dt><dd t-esc="row.requestedBy || '—'"/></div>
                            <div><dt>Creado</dt><dd t-esc="formatDate(row.createdAt)"/></div>
                            <div><dt>Actualizado</dt><dd t-esc="formatDate(row.updatedAt)"/></div>
                        </dl>
                        <p t-if="row.errorMessage" class="o_cpub_qerror" t-esc="row.errorMessage"/>
                        <p t-if="resultFor(row) &amp;&amp; resultFor(row).error" class="o_cpub_qerror" t-esc="resultFor(row).error"/>
                        <footer>
                            <button t-if="resultFor(row) &amp;&amp; resultFor(row).permalink" type="button" class="o_cpub_more"
                                    t-on-click="() => this.openLink(resultFor(row).permalink)">
                                Ver en MercadoLibre <i class="fa fa-external-link"/>
                            </button>
                            <button type="button" class="o_cedit_ghost" t-on-click="() => this.preview(row.sku)">
                                <i class="fa fa-eye"/> <span>Previsualizar</span>
                            </button>
                            <button type="button" class="o_cpub_primary" t-on-click="() => this.edit(row)">
                                <i class="fa fa-pencil"/> <span>Editar</span>
                            </button>
                        </footer>
                    </article>
                </section>

                <section t-else="" class="o_cpub_state">
                    <i class="fa fa-check-circle"/>
                    <strong>No hay nada listo para publicar.</strong>
                    <span>Acá aparecen los borradores que MercadoLibre ya acepta. Los que todavía rechaza están en Registros.</span>
                </section>
            </t>
        </div>
    </t>
</templates>
